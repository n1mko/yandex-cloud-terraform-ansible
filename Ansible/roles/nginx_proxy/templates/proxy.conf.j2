# Определение группы балансировки веб-серверов
upstream backend {
    server 10.128.0.3:80; # vm-2
    server 10.128.0.19:80; # vm-3
}

# Настройка проксирования трафика
server {
    listen 3000;

    location / {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
